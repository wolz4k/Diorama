<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Diorama.SettingsWindow"
        xmlns:controls="using:Diorama">
  <StackPanel Width="400" Margin="5" Spacing="5">
    <TextBlock>Files Source:</TextBlock>
    <controls:PropertyEditor Property="UsingArchives" />
    <controls:PropertyEditor Property="UsingExtracted" />
    <controls:PropertyEditor Property="ProviderPath" />
    
    <Button Click="GenerateFingerprints_Click" HorizontalAlignment="Center"
            ToolTip.Tip="Scan the game's scenes for the shaders each material uses, so Substitute Shader Set (in a material) can offer a matching set when you turn on a feature its shader lacks. Takes a while, and needs the Location above.">Generate Material Fingerprints</Button>
    <Button Click="SaveSettings_Click" HorizontalAlignment="Center">Save Settings</Button>
  </StackPanel>
</Window>
