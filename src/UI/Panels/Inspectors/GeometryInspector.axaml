<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Diorama">

  <!--
    Additional resources 
    Using Control Themes:
         https://docs.avaloniaui.net/docs/basics/user-interface/styling/control-themes
    Using Theme Variants:
         https://docs.avaloniaui.net/docs/guides/styles-and-resources/how-to-use-theme-variants
  -->
  
  <Design.PreviewWith>
    <StackPanel Width="400" Spacing="10">      
        <StackPanel Background="{DynamicResource SystemRegionBrush}">
          <controls:GeometryInspector />
        </StackPanel>
    </StackPanel>
  </Design.PreviewWith>
 
  <ControlTheme x:Key="{x:Type controls:GeometryInspector}" TargetType="controls:GeometryInspector">
    <Setter Property="Template">
      <ControlTemplate>
        <TabControl Margin="5">
          <TabItem Header="Model">
            <StackPanel Margin="5">
              <controls:Vec3Input
                  Value="{Binding Position, Mode=TwoWay}"
                  InputLabel="Position" IsEnabled="{Binding CanEditTransform}"/>
              <controls:Vec3Input
                  Value="{Binding Rotation, Mode=TwoWay}"
                  InputLabel="Rotation" IsEnabled="{Binding CanEditTransform}"/>
              <controls:Vec3Input
                  Value="{Binding Scale, Mode=TwoWay}"
                  InputLabel="Scale" IsEnabled="{Binding CanEditTransform}"/>
              <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="2,2,2,6"
                         IsVisible="{Binding !CanEditTransform}"
                         Text="This part has no position of its own (a character's parts are placed by its skeleton), so it can't be moved here. To move or reshape it, Export mesh, edit it in Blender, then Replace mesh." />
              <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="2,2,2,6" Text="{Binding LodNote}"
                         IsVisible="{Binding LodNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <WrapPanel>
                <Button Content="Replace mesh" x:Name="ReplaceMesh"
                        ToolTip.Tip="Swap this part's shape for one from an .OBJ or .glTF file (for example, one you edited in Blender). The material stays the same. Anything an .OBJ can't hold (bone weights, vertex alpha, lightmap UVs, and colours if it has none) is copied from the nearest vertex of the old shape. A report says what was carried over."/>
                <Button Content="Export mesh" x:Name="ExportMesh"
                        ToolTip.Tip="Save this part as an .OBJ (with an .MTL and its diffuse texture as a .DDS) or a .glTF, to edit in Blender. When exporting back to .OBJ from Blender, keep Y up / -Z forward and tick UV Coordinates, Normals and Colors."/>
                <Button Content="Undo replace" x:Name="UndoReplace"
                        ToolTip.Tip="Put back the mesh as it was before the last Replace mesh in this scene (each click undoes one more)."/>
                <Button Content="DEBUG" x:Name="DebugMesh" />
              </WrapPanel>
            </StackPanel>

          </TabItem>
          <TabItem Header="Material">
            <Grid Margin="5" RowDefinitions="Auto,Auto,*">
              <controls:ListInput Grid.Row="0" InputLabel="Material" Items="{Binding Parent.SceneOwner.Materials}" SelectedItem="{Binding Material}" CanBeNull="False"/>
              <StackPanel Grid.Row="1" IsVisible="{Binding !MaterialCompatible}" Orientation="Horizontal" Spacing="10" Margin="5">
                <TextBlock Foreground="Red" VerticalAlignment="Center" ToolTip.Tip="Material vertex layout does not align with mesh">Material Incompatible!</TextBlock>
                <Button x:Name="RebuildVertexDescriptors" ToolTip.Tip="Caution: If this material is used by other meshes, they will come out of alignment">Attempt Re-Align</Button>
              </StackPanel>
              <controls:MaterialPanel Grid.Row="2" Textures="{Binding DataContext.Controller.SelectedTextures, RelativeSource={RelativeSource AncestorType=controls:InspectorPanel}}" DataContext="{Binding Material}" />
            </Grid>
          </TabItem>
          <TabItem Header="Lightmap" IsVisible="{Binding Lightmap, Converter={x:Static ObjectConverters.IsNotNull}}"
                   ToolTip.Tip="The baked light and shadow this level part uses">
            <controls:LightmapPanel Textures="{Binding DataContext.Controller.SelectedTextures, RelativeSource={RelativeSource AncestorType=controls:InspectorPanel}}" DataContext="{Binding Lightmap}" />
          </TabItem>
        </TabControl>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
