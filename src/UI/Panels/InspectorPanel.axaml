<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Diorama"
        xmlns:views="using:Diorama.UI.ViewModels"
        xmlns:editor="using:Diorama.Editor">

  <!--
    Additional resources 
    Using Control Themes:
         https://docs.avaloniaui.net/docs/basics/user-interface/styling/control-themes
    Using Theme Variants:
         https://docs.avaloniaui.net/docs/guides/styles-and-resources/how-to-use-theme-variants
  -->
  
  <Design.PreviewWith>
    <StackPanel Width="400" Spacing="10">      
        <StackPanel Background="{DynamicResource SystemRegionBrush}">
          <controls:InspectorPanel />
        </StackPanel>
    </StackPanel>
  </Design.PreviewWith>
 
  <ControlTheme x:Key="{x:Type controls:InspectorPanel}" TargetType="controls:InspectorPanel">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
        <!-- what to do when nothing is picked yet -->
        <StackPanel Margin="12" Spacing="8" Opacity="0.7"
                    IsVisible="{Binding Controller.SelectedHierarchyObject, Converter={x:Static ObjectConverters.IsNull}}">
          <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding Controller.NoScenes}"
                     Text="Open a .GSC (level or prop) or .GHG (character) with File > Open, or drag one or more onto the window. Characters are in the game's CHARS folder, levels in LEVELS." />
          <TextBlock TextWrapping="Wrap" Text="Click a part in the view, or an item in the list above, to see and edit it here." />
          <TextBlock TextWrapping="Wrap" Text="Hold the right mouse button in the view to look around. While holding it, W A S D move, Space and Ctrl go up and down, and Shift goes faster." />
          <TextBlock TextWrapping="Wrap" Text="F moves the camera to the picked part." />
          <TextBlock TextWrapping="Wrap" Text="Right-click the scene's name in the list for saving, textures and exporting to Blender." />
          <TextBlock TextWrapping="Wrap" IsVisible="{Binding Controller.AnyMinifigPart}"
                     Text="Minifig parts from CHARS\SUPER_CHARACTER (the base minifig, hair, hats, capes...) show white here: the game colours them per character, from that character's own files (which Flux edits), not from the part." />
        </StackPanel>
        <ContentControl Content="{Binding Controller.SelectedHierarchyObject}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="editor:EditorGeometryObject">
              <controls:GeometryInspector />
            </DataTemplate>
            <DataTemplate DataType="editor:EditorPointOfInterest">
              <controls:PoIInspector />
            </DataTemplate>
            <DataTemplate DataType="editor:EditorJoint">
              <controls:JointInspector />
            </DataTemplate>
            <DataTemplate DataType="editor:EditorLayer">
              <controls:LayerInspector />
            </DataTemplate>
            <DataTemplate DataType="editor:EditorSceneObject">
              <controls:SceneObjectInspector />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
