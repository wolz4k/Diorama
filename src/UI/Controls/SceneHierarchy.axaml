<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Diorama.UI.Controls"
        xmlns:editor="using:Diorama.Editor"
        xmlns:rendering="using:Diorama.Rendering">

  <!--
    Additional resources 
    Using Control Themes:
         https://docs.avaloniaui.net/docs/basics/user-interface/styling/control-themes
    Using Theme Variants:
         https://docs.avaloniaui.net/docs/guides/styles-and-resources/how-to-use-theme-variants
  -->
  
  <Design.PreviewWith>
    <StackPanel Width="400" Spacing="10">      
        <StackPanel Background="{DynamicResource SystemRegionBrush}">
          <controls:SceneHierarchy />
        </StackPanel>
    </StackPanel>
  </Design.PreviewWith>
 
  <ControlTheme x:Key="{x:Type controls:SceneHierarchy}" TargetType="controls:SceneHierarchy">
    <Setter Property="Template">
      <ControlTemplate>
        <TreeView AutoScrollToSelectedItem="True" ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedHierarchyObject, Mode=TwoWay}">
          <TreeView.DataTemplates>
            <TreeDataTemplate DataType="editor:EditorScene" ItemsSource="{Binding HierarchyItems}">
              <TextBlock Text="{Binding Name}">
                <TextBlock.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Save GScene" Command="{Binding $parent[TreeView].DataContext.SaveSceneCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Overwrite the file you opened (the first save keeps the original as .bak)"/>
                    <MenuItem Header="Save GScene As..." Command="{Binding $parent[TreeView].DataContext.SaveSceneAsCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Save to a new file, for example in your mod folder. Its textures (with any you replaced) are saved beside it, and its .RES and shader files copied, under the new name."/>
                    <MenuItem Header="Close Scene" Command="{Binding $parent[TreeView].DataContext.RemoveSceneCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Close it in Diorama. The file isn't touched; unsaved changes are lost."/>
                    <MenuItem Header="Export Scene as glTF..." Command="{Binding $parent[TreeView].DataContext.ExportSceneCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Write the whole scene to a .glTF, for Blender or other 3D tools"/>
                    <MenuItem Header="Export Parts as OBJ..." Command="{Binding $parent[TreeView].DataContext.ExportPartsObjCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Write every part shown right now (the picked LOD) to one .OBJ for Blender, one object per part, with its textures."/>
                    <MenuItem Header="Replace Parts from OBJ..." Command="{Binding $parent[TreeView].DataContext.ReplacePartsObjCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Bring back an .OBJ made with Export Parts as OBJ. Each object replaces the part its name ends with (__m number); unchanged parts are left alone."/>
                    <MenuItem Header="Bring In Part from Another Game..." Command="{Binding $parent[TreeView].DataContext.TransplantPartCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Open one of this game's character parts first (wings, cape, hat), then pick another LEGO game's part of the same kind: its shape and bone weights move into this model, which keeps this game's materials so the game can draw it. Save As a new name afterwards."/>
                    <MenuItem Header="Undo Mesh Replacement" Command="{Binding $parent[TreeView].DataContext.UndoMeshReplaceCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Put back the meshes as they were before the last Replace mesh or Replace Parts from OBJ (each use undoes one more)."/>
                    <MenuItem Header="Edit Resource Header" Command="{Binding $parent[TreeView].DataContext.EditResourceHeaderCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="The other files this scene names: its textures, shaders, the LEGO texture page, shared texture scenes. Save As doesn't rename them."/>
                    <MenuItem Header="Edit Textures" Command="{Binding $parent[TreeView].DataContext.EditTexturesCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="See every texture of the scene, export one as .DDS to paint over, and replace it with yours"/>
                    <MenuItem Header="Save Textures" Command="{Binding $parent[TreeView].DataContext.SaveTexturesCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="Write replaced textures into the scene's .NXG_TEXTURES (the first save keeps the original as .bak)"/>
                  </ContextMenu>
                </TextBlock.ContextMenu>  
              </TextBlock>
            </TreeDataTemplate>
            <TreeDataTemplate DataType="editor:EditorHierarchyGroup" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Name}"/>
            </TreeDataTemplate>
            <TreeDataTemplate DataType="editor:EditorPointOfInterest">
              <TextBlock Text="{Binding DisplayName}"/>
            </TreeDataTemplate>
            <TreeDataTemplate DataType="editor:EditorJoint" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding DisplayName}"/>
            </TreeDataTemplate>
            <TreeDataTemplate DataType="editor:EditorSceneObject" ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding DisplayName}"/>
            </TreeDataTemplate>
            <TreeDataTemplate DataType="editor:EditorLodGroup" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" TextDecorations="Underline" VerticalAlignment="Center" Width="150" IsVisible="{Binding IsActive}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Width="150" IsVisible="{Binding !IsActive}"/>
                <TextBox Text="{Binding FadeDistance}" VerticalAlignment="Center" ToolTip.Tip="This can, and likely will, be overridden if this is used as an attachment/in animations. Cannot currently be saved back to the GSC."/>
              </StackPanel>
            </TreeDataTemplate>
            <TreeDataTemplate DataType="editor:EditorGeometryObject">
              <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Summary}"/>
            </TreeDataTemplate>
            <TreeDataTemplate DataType="controls:INamedItem">
              <TextBlock Text="{Binding DisplayName}"/>
            </TreeDataTemplate>
          </TreeView.DataTemplates>
        </TreeView>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
